{
  "name": "amplifi-optimize",
  "version": "1.0.0",
  "description": "AI-powered SEO triage for WordPress: scans for fixable issues, drafts fixes with Claude, lets a human approve each one.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "homepage": "https://amplifi.studio/",
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=assets/src --output-path=assets/build",
    "start": "wp-scripts start --webpack-src-dir=assets/src --output-path=assets/build",
    "lint:js": "wp-scripts lint-js assets/src",
    "lint:css": "wp-scripts lint-style 'assets/src/**/*.scss'",
    "format": "wp-scripts format assets/src",
    "packages-update": "wp-scripts packages-update"
  },
  "devDependencies": {
    "@wordpress/scripts": "^27.0.0"
  }
}
